#!/bin/sh

case "$1" in
  left)
    workspace_id=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id')
    [ "$workspace_id" -le 1 ] && exit 0
    # Use the adjacent numeric workspace, creating it when it is empty.
    target=$((workspace_id - 1))
    ;;
  right)
    # Keep a lone window on its current workspace when swiping right.
    workspace_id=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id')
    window_count=$(hyprctl clients -j 2>/dev/null | jq --argjson id "$workspace_id" '[.[] | select(.workspace.id == $id)] | length')
    highest_workspace=$(hyprctl workspaces -j 2>/dev/null | jq '[.[] | select(.id > 0) | .id] | max // 0')
    # A lone window may still move right when an existing workspace is there.
    # Only stop at the right edge when it is alone on the highest workspace.
    [ "$window_count" -le 1 ] && [ "$workspace_id" -eq "$highest_workspace" ] && exit 0
    if [ "$workspace_id" -eq "$highest_workspace" ]; then
      # Explicitly create the next numbered workspace at the right edge.
      target=$((workspace_id + 1))
    else
      target='e+1'
    fi
    ;;
  *) exit 2 ;;
esac

exec hyprctl eval "hl.dispatch(hl.dsp.window.move({ workspace = \"$target\" }))"
